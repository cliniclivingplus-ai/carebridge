# Copy this file to .env and fill in real values when you have them.
# Until CLINICEA_API_KEY is set, the app runs on built-in mock data.

CLINICEA_API_KEY=
CLINICEA_BASE_URL=https://api.clinicea.com

# Which appointment service(s) count as "physiotherapy".
# Comma-separated, case-insensitive substring match against AppointmentServiceName / AppointmentServiceCategory.
PHYSIO_SERVICE_FILTER=physio

# Without DATABASE_URL: partner accounts come from data/partners.json (plain-text demo passwords)
# and appointments live in data/db.json. Fine for local dev, not for production.
#
# With DATABASE_URL set: partner accounts and appointments live in Postgres instead --
# hashed passwords, DB-backed sessions. Render sets this automatically (see render.yaml).
# Locally, point it at any Postgres instance to test the production path:
DATABASE_URL=

SESSION_SECRET=change-me-to-a-random-string

# Required once this is deployed publicly: Clinicea doesn't sign its webhook calls, so this
# secret is embedded in the webhook URL itself (.../webhooks/clinicea/<WEBHOOK_SECRET>/appointment/add)
# so random internet traffic can't feed fake appointments into your dashboard.
# Leave blank in local/mock mode -- the check is skipped when unset.
WEBHOOK_SECRET=

PORT=3000

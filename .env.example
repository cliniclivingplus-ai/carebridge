# CareBridge Environment Configuration Template
# Copy this file to .env and fill in your actual production/development credentials.

# Required Production Secrets
SESSION_SECRET=your_super_secret_session_key_here
WEBHOOK_SECRET=your_clinicea_webhook_secret_here

# Optional: Clinicea API Integration (Omit for local offline demo mode)
CLINICEA_API_KEY=your_clinicea_api_key
CLINICEA_BASE_URL=https://api.clinicea.com/v1

# Attach each home-visit session to the patient's documents in Clinicea as a PDF report
# ("Clinical Report"). While "false", sessions are saved in CareBridge as "Not yet sent" and
# can be sent later with the "Send to Clinicea" button.
CLINICEA_SESSION_SYNC=false

# Optional: PostgreSQL Database URL (Omit to use fallback local JSON storage data/partners.json & data/patient_plans.json)
DATABASE_URL=postgres://user:password@ep-sample-123456.pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: Vercel Cron Endpoint Secret Authorization
CRON_SECRET=your_vercel_cron_secret_bearer_token

# Optional: Server Port & Node Environment
PORT=3000
NODE_ENV=development

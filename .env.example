# Copy this file to .env and fill in real values when you have them.
# Until CLINICEA_API_KEY is set, the app runs on built-in mock data.

CLINICEA_API_KEY=
CLINICEA_BASE_URL=https://api.clinicea.com

# Which appointment service(s) count as "physiotherapy".
# Comma-separated, case-insensitive substring match against AppointmentServiceName / AppointmentServiceCategory.
PHYSIO_SERVICE_FILTER=physio

# Which patient identifier the "look up by ID" feature searches by. Confirmed against the
# real Clinicea API: 0 = File Number (the everyday clinic ID, e.g. "CLP23") -- the default,
# since that's what clinic staff actually use day to day. 1 = Unique Number (NRIC/PAN/Passport
# -- what Clinicea's own data model literally calls "PatientUniqueIDNumber"). Switch to 1 if
# your "unique ID" specifically means that field rather than the File Number.
PATIENT_ID_SEARCH_BY=0

# Without DATABASE_URL: partner accounts come from data/partners.json (plain-text demo passwords)
# and appointments live in data/db.json. Fine for local dev, not for production.
#
# With DATABASE_URL set: partner accounts and appointments live in Postgres instead --
# hashed passwords, DB-backed sessions. In production this is Vercel Postgres: create it
# under the Storage tab of your Vercel project, and it sets this env var automatically.
# Locally, point it at that same Vercel Postgres instance (or any Postgres) to test the
# production path -- `vercel env pull .env` will fetch the real value for you.
DATABASE_URL=

SESSION_SECRET=change-me-to-a-random-string

# Required once this is deployed publicly: Clinicea doesn't sign its webhook calls, so this
# secret is embedded in the webhook URL itself (.../webhooks/clinicea/<WEBHOOK_SECRET>/appointment/add)
# so random internet traffic can't feed fake appointments into your dashboard.
# Leave blank in local/mock mode -- the check is skipped when unset.
WEBHOOK_SECRET=

# Only used by server.js for local dev. Vercel assigns its own port/domain in production
# and this is ignored there.
PORT=3000

# ---------- New-booking notifications (email/SMS) ----------
# Both are optional and independent -- leave either blank and it just logs + no-ops instead
# of sending. Notifications go to whichever team members (data/partners.json, or the
# `partners` table) have an email/phone on file.

# Email via Resend (https://resend.com) -- create an account, verify a sending domain (or
# use their shared onboarding@resend.dev sender for testing), and generate an API key.
RESEND_API_KEY=
EMAIL_FROM=CareBridge <onboarding@resend.dev>

# SMS via Twilio (https://twilio.com) -- create an account, buy/verify a phone number, and
# find Account SID + Auth Token on the console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Hard kill switch, checked BEFORE either channel above: nothing actually sends unless this
# is exactly "true", no matter what keys are configured. Keep "false" while still building
# and testing -- flip to "true" only when real notifications should start going out.
NOTIFICATIONS_ENABLED=false

# Protects /api/cron/scan-new-bookings (called on a schedule by Vercel Cron -- see
# vercel.json) from being triggered by random internet traffic. Any long random string;
# Vercel Cron is configured to send it automatically once set as an env var there.
# Leave blank locally -- the check is skipped when unset.
CRON_SECRET=
